# ─────────────────────────────────────────────────────────────
# VidGrab production (internal) environment.
# Copy to infra/.env.prod and fill in. NEVER commit the real file.
#
#   cp infra/.env.prod.example infra/.env.prod
#
# Used both for docker compose interpolation (--env-file) and as each
# container's env_file. Hostnames are the compose SERVICE names.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# --- Public address (the URL your team opens) ---
# The domain that points at this server's public IP (A/AAAA record).
DOMAIN=vidgrab.yourcompany.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@yourcompany.com
# Must be https://<DOMAIN> — baked into the web bundle AND used for download links.
PUBLIC_BASE_URL=https://vidgrab.yourcompany.com

# --- Login (HTTP basic auth in Caddy) ---
BASIC_AUTH_USER=team
# bcrypt hash for the password. IMPORTANT: docker compose eats single "$", so the
# hash must have every "$" DOUBLED to "$$". Generate an already-escaped value with:
#   docker run --rm caddy caddy hash-password --plaintext 'choose-a-strong-password' | sed 's/\$/$$/g'
# Paste that output below (it will look like $$2a$$14$$...). No quotes.
BASIC_AUTH_HASH=REPLACE_WITH_ESCAPED_BCRYPT_HASH

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Same-origin in this setup; keep it equal to PUBLIC_BASE_URL.
CORS_ORIGIN=https://vidgrab.yourcompany.com

# --- Database (internal Postgres service) ---
POSTGRES_USER=vidgrab
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=vidgrab
DATABASE_URL=postgres://vidgrab:CHANGE_ME_strong_db_password@postgres:5432/vidgrab

# --- Redis (internal service) ---
REDIS_URL=redis://redis:6379

# --- Object storage (internal MinIO; API streams files, nothing public) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=vidgrab-downloads
S3_ACCESS_KEY_ID=vidgrab
S3_SECRET_ACCESS_KEY=CHANGE_ME_strong_s3_secret
S3_FORCE_PATH_STYLE=true

# --- Lifecycle / limits ---
OBJECT_TTL_HOURS=24
WORKER_CONCURRENCY=2
TMP_DIR=/tmp/vidgrab
# Internal use → generous caps. Tighten if needed.
RATE_LIMIT_JOBS_PER_HOUR=200
MAX_FILESIZE_BYTES=5368709120
MAX_DURATION_SECONDS=21600
QUEUE_CIRCUIT_BREAKER_MAX=500

# --- yt-dlp / ffmpeg (bundled in the worker image) ---
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Keep the extractor current (YouTube/Instagram change often).
YTDLP_AUTO_UPDATE=true

# --- Bot defense / proxies: OFF for internal use ---
# Turnstile disabled (empty). Internal tool behind a login.
TURNSTILE_SECRET=
# No residential proxies for low-volume internal use. Add comma-separated
# http://user:pass@host:port entries here if you start getting blocked.
PROXY_URLS=
# Optional: path to an Instagram cookies.txt (mounted into the worker) for
# private posts/stories. Leave empty for public content.
INSTAGRAM_COOKIES_FILE=
