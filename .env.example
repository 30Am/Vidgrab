# ─────────────────────────────────────────────────────────────
# VidGrab environment. Copy to .env and adjust for local dev.
# Local stack (postgres, redis, minio) comes from infra/docker-compose.yml.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- API service ---
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgres://vidgrab:vidgrab@localhost:5433/vidgrab

# --- Redis (cache + BullMQ) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (S3-compatible: MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=vidgrab-downloads
S3_ACCESS_KEY_ID=vidgrab
S3_SECRET_ACCESS_KEY=vidgrabsecret
# MinIO needs path-style; R2/S3 work with virtual-host style (set to false in prod).
S3_FORCE_PATH_STYLE=true
# Public base used to rewrite presigned URLs for the browser (optional; e.g. CDN domain).
S3_PUBLIC_BASE_URL=http://localhost:9000

# --- Presigned URL / lifecycle ---
DOWNLOAD_URL_TTL_SECONDS=3600
OBJECT_TTL_HOURS=24

# --- Worker ---
WORKER_CONCURRENCY=4
TMP_DIR=/tmp/vidgrab
# Path to the yt-dlp binary. Leave as "yt-dlp" to use the one on PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Auto-update yt-dlp on worker boot (true in prod).
YTDLP_AUTO_UPDATE=false

# --- Abuse / limits ---
RATE_LIMIT_JOBS_PER_HOUR=10
MAX_FILESIZE_BYTES=3221225472
MAX_DURATION_SECONDS=14400
QUEUE_CIRCUIT_BREAKER_MAX=500

# --- Bot defense (Cloudflare Turnstile) ---
# Leave TURNSTILE_SECRET empty to DISABLE verification (local dev).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Proxies (residential pool). Empty = direct connection (local dev only). ---
# Comma-separated proxy URLs, e.g. http://user:pass@host:port,http://user:pass@host2:port
PROXY_URLS=

# --- Instagram ---
# Path to a cookies.txt exported from a logged-in (burner) account. Optional.
INSTAGRAM_COOKIES_FILE=

# --- Web frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
