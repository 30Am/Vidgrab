{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "port": 4000
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:worker"],
      "autoPort": true
    },
    {
      "name": "cleanup-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vidgrab/worker", "dev:cleanup"],
      "autoPort": true
    }
  ]
}
