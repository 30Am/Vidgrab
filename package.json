{
  "name": "vidgrab",
  "version": "1.0.0",
  "private": true,
  "description": "Public video downloader for YouTube and Instagram",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @vidgrab/api dev",
    "dev:worker": "pnpm --filter @vidgrab/worker dev",
    "dev:web": "pnpm --filter @vidgrab/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @vidgrab/db generate",
    "db:migrate": "pnpm --filter @vidgrab/db migrate",
    "db:push": "pnpm --filter @vidgrab/db push",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
